# ---- Chip / flash (ESP32-S3 N16R8: 16 MB quad flash, 8 MB octal PSRAM) ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- Partition table ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM (octal, 8 MB) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Keep internal RAM for I2S DMA, Slint and the AFE: Wi-Fi/LWIP/TLS buffers go to PSRAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ---- Cache (recommended by ESP-SR for WakeNet speed) ----
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- ESP-SR: models live in the "model" flash partition ----
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_JARVIS_TTS=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# ---- HTTPS: verify api.groq.com with the built-in CA bundle ----
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Software AES: the AES DMA engine can't read the PSRAM TLS buffers, so it
# copies each record through internal RAM. With MQTT + Groq TLS sessions open
# that allocation failed ("esp-aes: Failed to allocate memory").
# CONFIG_MBEDTLS_HARDWARE_AES is not set

# ---- Console on the native USB port (same port Arduino's Serial used) ----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Raw "\n" so DUMP's binary WAV isn't altered
CONFIG_NEWLIB_STDOUT_LINE_ENDING_LF=y
CONFIG_NEWLIB_STDIN_LINE_ENDING_LF=y

# ---- Stacks / RTOS / speed ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- Internal RAM headroom (sockets, Wi-Fi frames and DMA failed at 9 KB free) ----
# Wi-Fi hot paths stay in flash instead of IRAM (~25 KB back to the heap on S3)
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# Static RX buffers must be internal: 16 -> 10 (~10 KB)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
# Network task stacks are allocated in PSRAM (xTaskCreatePinnedToCoreWithCaps)
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
