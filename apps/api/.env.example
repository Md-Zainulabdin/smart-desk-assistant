# App
ENV=dev
DEFAULT_TIMEZONE=UTC

# Google OAuth (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Comma-separated emails allowed to sign in. Leave empty to allow any verified
# Google account (development only; set this in production).
ALLOWED_GOOGLE_EMAILS=

# App secrets
SESSION_SECRET=
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=sd_session
COOKIE_SECURE=false

# Database: Neon in production, Docker Compose Postgres locally
DATABASE_URL=postgresql://smartdesk:smartdesk_dev@localhost:5432/smartdesk

# Origins
API_BASE_URL=http://localhost:8000
PWA_ORIGIN=http://localhost:3000
# To use the dev playground page at http://localhost:8000/ instead of the PWA,
# set PWA_ORIGIN=http://localhost:8000 so sign-in returns to it.

# Speech-to-text runs on the device, so the backend does not call Groq.
GROQ_API_KEY=

# Tavily web search
TAVILY_API_KEY=

# Phase 3 (Google Calendar) - not used yet
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/auth/google/calendar/callback
TOKEN_ENCRYPTION_KEY=
